# Copy this file to .env and fill in your own values.
# Get cookies from your browser: DevTools -> Application/Storage -> Cookies -> https://x.com
# NEVER commit .env or share these values with anyone (including in chat) —
# auth_token is a full account session credential.

TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# X handle (no @) of the page to count mentions of
TARGET_PAGE=Telegraphprotoc

# How many recent tweets per account to scan
SCAN_LIMIT=100

PORT=3100
